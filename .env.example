# Copy to .env and fill in. Never commit .env.
# With DATABASE_URL empty the app uses a local SQLite file, which is how
# development runs. Railway provides the MySQL URL in production.

SECRET_KEY=
DATABASE_URL=

# Phase 4. ADMIN changes everything, VIEWER only reads. One shared VIEWER
# password for the few people who need to see who is winning.
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# Minutes a bidder may cancel their own bid. Default 10.
SELF_CANCEL_MINUTES=10

# Phase 3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
